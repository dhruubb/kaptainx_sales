# Copy this file to private/.env and fill it in there. NEVER put real keys in THIS file.
# Supabase → Project Settings → API Keys
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The SECRET key (starts with sb_secret_). Older projects: the legacy service_role key.
SUPABASE_SECRET_KEY=paste-your-secret-key-in-private/.env-not-here
